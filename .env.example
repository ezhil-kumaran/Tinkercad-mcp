# Tinkercad Circuits MCP Server - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Headless mode: true (default) for headless automation, false to show browser window
TINKERCAD_HEADLESS=true

# Persistent browser profile directory (defaults to .tinkercad_profile in project root)
# TINKERCAD_PROFILE_DIR=.tinkercad_profile

# Screenshots output directory (defaults to screenshots in project root)
# TINKERCAD_SCREENSHOTS_DIR=screenshots

# Default operation timeout in milliseconds (default: 35000)
# TINKERCAD_TIMEOUT_MS=35000

# Disable Chromium sandbox (only recommended for root users inside Docker containers)
# TINKERCAD_NO_SANDBOX=false
